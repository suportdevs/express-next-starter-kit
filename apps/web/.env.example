# Internal URL of the Express API (used by Next.js rewrites and server components)
API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="SaaS Kit"
# Public URL of the site (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Auth page layout: centered | split-left | split-right | fullscreen | card |
# youtube-video | animated-birds | aurora-waves | particle-network | tidal
NEXT_PUBLIC_AUTH_LAYOUT=centered
# YouTube video id for the youtube-video layout (muted, looped background)
NEXT_PUBLIC_AUTH_YOUTUBE_ID=
# Floating layout picker on auth pages (defaults to on in development only)
NEXT_PUBLIC_AUTH_LAYOUT_SWITCHER=
